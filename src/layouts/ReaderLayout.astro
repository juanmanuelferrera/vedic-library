---
import '../styles/reset.css';
import '../styles/themes.css';
import '../styles/writebook.css';
import BookHeader from '../components/BookHeader.astro';
import ContentsDrawer from '../components/ContentsDrawer.astro';
import SettingsDrawer from '../components/SettingsDrawer.astro';
import SearchDialog from '../components/SearchDialog.astro';
import ReadingProgress from '../components/ReadingProgress.astro';

interface LangSibling {
  lang: string;
  label: string;
  href: string;
  isCurrent: boolean;
}
interface Props {
  bookId: string;
  bookTitle: string;
  bookLang: string;
  pageTitle: string;
  chapters: any[];
  currentSlug?: string;
  langs?: LangSibling[];
  fallbackSlugs?: string[];
}
const { bookId, bookTitle, bookLang, pageTitle, chapters, currentSlug, langs = [], fallbackSlugs = [] } = Astro.props;
---
<!doctype html>
<html lang={bookLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle} · {bookTitle}</title>
    <script is:inline>
      (function () {
        var html = document.documentElement;
        var get = function (k, d) { try { return localStorage.getItem(k) || d; } catch (e) { return d; } };
        html.dataset.theme   = get('wb-theme', 'light');
        html.dataset.font    = get('wb-font', 'sans');
        html.dataset.size    = get('wb-size', '4');
        html.dataset.justify = get('wb-justify', 'off');
      })();
    </script>
  </head>
  <body>
    <ReadingProgress />
    <BookHeader bookId={bookId} bookTitle={bookTitle} pageTitle={pageTitle} langs={langs} />

    <main class="reader" data-pagefind-body>
      <article>
        <slot />
      </article>
    </main>

    <ContentsDrawer
      bookId={bookId}
      bookTitle={bookTitle}
      chapters={chapters}
      currentSlug={currentSlug}
      fallbackSlugs={fallbackSlugs}
    />
    <SettingsDrawer />
    <SearchDialog />

    <script is:inline>
      (function () {
        // Chapters are swapped in by the client router, so anything bound to an
        // element has to be bound again on each swap. Marking the element keeps
        // that idempotent; window/document listeners are attached once, since
        // those objects survive navigation.
        // Must match the defaults in the head script. The theme tokens live
        // under html[data-theme=…]; leaving the attribute off leaves --bg
        // undefined, which shows up as transparent drawers, so every key is
        // always written, whether or not the reader ever chose one.
        var PREFS = { theme: 'light', font: 'sans', size: '4', justify: 'off' };

        function applyPrefs(html) {
          Object.keys(PREFS).forEach(function (k) {
            var v = PREFS[k];
            try { v = localStorage.getItem('wb-' + k) || v; } catch (e) {}
            html.dataset[k] = v;
          });
        }

        function once(el, ev, fn, mark) {
          if (!el || el.dataset[mark]) return;
          el.dataset[mark] = '1';
          el.addEventListener(ev, fn);
        }

        function closeDrawers() {
          document.querySelectorAll('.drawer, .drawer-overlay').forEach(function (n) {
            n.classList.remove('open');
          });
        }

        }

        function refreshActiveStates() {
          var html = document.documentElement;
          document.querySelectorAll('[data-setting]').forEach(function (group) {
            var key = group.dataset.setting;
            var current = html.dataset[key];
            group.querySelectorAll('button').forEach(function (b) {
              b.classList.toggle('active', b.dataset.value === current);
            });
          });
        }

        function bindPage() {
          [['open-contents', 'contents-drawer', 'contents-overlay'],
           ['open-settings', 'settings-drawer', 'settings-overlay']].forEach(function (ids) {
            var btn = document.getElementById(ids[0]);
            var drawer = document.getElementById(ids[1]);
            var overlay = document.getElementById(ids[2]);
            if (!btn || !drawer || !overlay) return;
            once(btn, 'click', function () {
              drawer.classList.add('open'); overlay.classList.add('open');
            }, 'wbOpen');
            once(overlay, 'click', closeDrawers, 'wbClose');
          });



          // Belt and braces: before-swap should have handled it already.
          applyPrefs(document.documentElement);

          document.querySelectorAll('[data-setting] button').forEach(function (b) {
            once(b, 'click', function () {
              var group = b.closest('[data-setting]');
              var key = group.dataset.setting;
              document.documentElement.dataset[key] = b.dataset.value;
              try { localStorage.setItem('wb-' + key, b.dataset.value); } catch (e) {}
              refreshActiveStates();
            }, 'wbSet');
          });
          refreshActiveStates();
        }

        if (!window.__wbGlobals) {
          window.__wbGlobals = true;



          // Keyboard shortcuts: c, s, Escape, ← →
          window.addEventListener('keydown', function (e) {
            var t = e.target;
            if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA')) return;
            if (e.key === 'Escape') closeDrawers();
            if (e.key === 'c') document.getElementById('open-contents')?.click();
            if (e.key === 's') document.getElementById('open-settings')?.click();
            if (e.key === 'ArrowLeft') document.querySelector('.prev-next .prev-pill')?.click();
            if (e.key === 'ArrowRight') document.querySelector('.prev-next .next-pill')?.click();
          });

          // Swipe left/right to turn the page on touch devices.
          var sx = 0, sy = 0, st = 0, tracking = false;
          document.addEventListener('touchstart', function (e) {
            if (e.touches.length !== 1) { tracking = false; return; }
            // Not a page turn if a drawer is open, or if the finger landed on
            // something that scrolls sideways itself (wide tables, code).
            if (document.querySelector('.drawer.open')) { tracking = false; return; }
            var el = e.target;
            while (el && el !== document.body) {
              if (el.scrollWidth > el.clientWidth + 4) { tracking = false; return; }
              el = el.parentElement;
            }
            sx = e.touches[0].clientX;
            sy = e.touches[0].clientY;
            st = Date.now();
            tracking = true;
          }, { passive: true });

          document.addEventListener('touchend', function (e) {
            if (!tracking) return;
            tracking = false;
            var t = e.changedTouches[0];
            var dx = t.clientX - sx, dy = t.clientY - sy;
            // Horizontal, decisive, and not a slow drag.
            if (Math.abs(dx) < 70) return;
            if (Math.abs(dx) < Math.abs(dy) * 1.8) return;
            if (Date.now() - st > 700) return;
            var sel = dx < 0 ? '.prev-next .next-pill' : '.prev-next .prev-pill';
            document.querySelector(sel)?.click();
          }, { passive: true });

        }

        bindPage();
      })();
    </script>
  </body>
</html>
