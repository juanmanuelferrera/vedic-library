---
import { render } from 'astro:content';
import ReaderLayout from '../../layouts/ReaderLayout.astro';
import PrevNext from '../../components/PrevNext.astro';
import BuyTeaser from '../../components/BuyTeaser.astro';
import { getBooks, getSections, getNeighbours, chapterSlug, getLangSiblings } from '../../lib/books';

export async function getStaticPaths() {
  const books = await getBooks();
  const paths = [];
  for (const b of books) {
    for (const { entry, fallback } of await getSections(b.id)) {
      paths.push({
        params: { book: b.id, chapter: chapterSlug(entry.id) },
        props: { entry, bookMeta: b, fallback },
      });
    }
  }
  return paths;
}

// Shown when this language has no translation of the section yet.
const UNTRANSLATED: Record<string, string> = {
  es: 'Esta sección todavía no está traducida al español. Se muestra en inglés.',
  pt: 'Esta seção ainda não está traduzida para o português. É exibida em inglês.',
  hi: 'यह अनुभाग अभी हिन्दी में अनूदित नहीं है। इसे अंग्रेज़ी में दिखाया गया है।',
  ru: 'Этот раздел ещё не переведён на русский язык. Он показан на английском.',
};

const { entry, bookMeta, fallback } = Astro.props;
const { book: bookId, chapter: currentSlug } = Astro.params;
const sections = await getSections(bookId!);
const chapters = sections.map(s => s.entry);
const fallbackSlugs = sections.filter(s => s.fallback).map(s => chapterSlug(s.entry.id));
const { prev, next, index, total } = await getNeighbours(bookId!, currentSlug!);
const langs = await getLangSiblings(bookId!, entry.data.order);

const { Content } = await render(entry);
---
<ReaderLayout
  bookId={bookMeta.id}
  bookTitle={bookMeta.title}
  bookLang={bookMeta.lang}
  pageTitle={entry.data.title}
  chapters={chapters}
  currentSlug={currentSlug}
  langs={langs}
  fallbackSlugs={fallbackSlugs}
>
  <h1>{entry.data.title}</h1>
  {fallback && (
    <p class="untranslated" lang={bookMeta.lang}>
      {UNTRANSLATED[bookMeta.lang] ?? 'This section is not translated yet. It is shown in English.'}
    </p>
  )}
  <Content />
  {!next && <BuyTeaser lang={bookMeta.lang} />}
  <PrevNext bookId={bookMeta.id} prev={prev} next={next} />
</ReaderLayout>
