---
// In-book search dialog (Writebook style).
// Uses Pagefind index built at /pagefind/ on build.
---
<dialog class="search-dialog" id="search-dialog" aria-label="Search">
  <button class="search-close" id="search-close" aria-label="Close">
    <span class="ico" style="--ico:url(/icons/remove.svg); --ico-size:1em"></span>
  </button>
  <form class="search-form" id="search-form" role="search" action="/search">
    <span class="search-icon" aria-hidden="true">
      <span class="ico" style="--ico:url(/icons/search.svg); --ico-size:1.3em"></span>
    </span>
    <input
      type="search"
      id="search-input"
      name="q"
      placeholder="Find in this book…"
      autocomplete="off"
      spellcheck="false"
    />
    <button type="submit" class="search-submit" aria-label="Search">
      <span class="ico" style="--ico:url(/icons/arrow-right.svg); --ico-size:1em"></span>
    </button>
  </form>
  <div class="search-results" id="search-results" hidden></div>
</dialog>

<script is:inline>
  (function () {
    // The dialog and its buttons are replaced on every client-side navigation,
    // so look them up per call and rebind on each swap rather than capturing
    // them once — a captured node would be detached after the first chapter.
    function el(id) { return document.getElementById(id); }

    function open() {
      var dlg = el('search-dialog');
      if (!dlg) return;
      if (typeof dlg.showModal === 'function' && !dlg.open) dlg.showModal();
      else dlg.setAttribute('open', '');
      setTimeout(function () { var i = el('search-input'); i && i.focus(); }, 30);
    }
    function close() {
      var dlg = el('search-dialog');
      if (!dlg) return;
      if (typeof dlg.close === 'function') dlg.close();
      else dlg.removeAttribute('open');
    }

    function once(node, ev, fn, mark) {
      if (!node || node.dataset[mark]) return;
      node.dataset[mark] = '1';
      node.addEventListener(ev, fn);
    }

    // Live results via Pagefind (loaded lazily, only if available).
    var pf = null;
    function loadPagefind() {
      if (pf) return Promise.resolve(pf);
      return import('/pagefind/pagefind.js').then(function (mod) {
        pf = mod;
        return pf;
      }).catch(function () {
        pf = false; // mark as unavailable
        return null;
      });
    }

    var timer = null;
    function onInput() {
      var input = el('search-input');
      var results = el('search-results');
      if (!input || !results) return;
      var q = input.value.trim();
      if (!q) { results.hidden = true; results.innerHTML = ''; return; }
      if (timer) clearTimeout(timer);
      timer = setTimeout(function () {
        loadPagefind().then(function (mod) {
          if (!mod) {
            results.hidden = false;
            results.innerHTML = '<p class="search-noindex">Search index not available yet. Build the site to enable.</p>';
            return;
          }
          mod.search(q).then(function (sr) {
            Promise.all(sr.results.slice(0, 8).map(function (r) { return r.data(); }))
              .then(function (items) {
                if (!items.length) {
                  results.hidden = false;
                  results.innerHTML = '<p class="search-empty">No results.</p>';
                  return;
                }
                results.hidden = false;
                results.innerHTML = items.map(function (it) {
                  return '<a class="search-result" href="' + it.url + '">' +
                    '<strong>' + (it.meta && it.meta.title ? it.meta.title : it.url) + '</strong>' +
                    '<span>' + (it.excerpt || '').slice(0, 180) + '</span></a>';
                }).join('');
              });
          });
        });
      }, 160);
    }

    function bindSearch() {
      once(el('open-search'), 'click', open, 'wbSearchOpen');
      once(el('search-close'), 'click', close, 'wbSearchClose');
      once(el('search-dialog'), 'click', function (e) {
        if (e.target === el('search-dialog')) close();
      }, 'wbSearchBackdrop');
      once(el('search-input'), 'input', onInput, 'wbSearchInput');
      // Submitting would navigate to /search, which does not exist; results
      // are live as you type.
      once(el('search-form'), 'submit', function (e) { e.preventDefault(); }, 'wbSearchSubmit');
    }

    if (!window.__wbSearchGlobals) {
      window.__wbSearchGlobals = true;
      window.addEventListener('keydown', function (e) {
        var a = document.activeElement;
        if (e.key === '/' && a && a.tagName !== 'INPUT' && a.tagName !== 'TEXTAREA') {
          e.preventDefault();
          open();
        }
        if (e.key === 'Escape') close();
      });
      document.addEventListener('astro:page-load', bindSearch);
    }

    bindSearch();
  })();
</script>
